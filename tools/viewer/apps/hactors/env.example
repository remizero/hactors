# ----------------------------------------------------------
# Configuración de la aplicación hactors — viewer de HACTORS
# ----------------------------------------------------------
# Copiar este archivo a apps/hactors/.env antes de arrancar.
# Success exige que exista: sin él el validador descarta la aplicación.
# ----------------------------------------------------------

APP_ENV = 'development'
FLASK_ENV = 'development'
DEBUG = True

SECRET_KEY = 'hactors_viewer_local'

# La aplicación no usa ninguna extensión de Flask; SECRET_KEY firma la marca de
# su operación de escritura, así que un formulario ajeno no puede enviarla.
SUCCESS_EXTENSION_ACL = False
SUCCESS_EXTENSION_ADMIN = False
SUCCESS_EXTENSION_APSCHEDULER = False
SUCCESS_EXTENSION_BABEL = False
SUCCESS_EXTENSION_BLUEPRINT = False
SUCCESS_EXTENSION_CACHE = False
SUCCESS_EXTENSION_CORS = False
SUCCESS_EXTENSION_EMAIL = False
SUCCESS_EXTENSION_JWT = False
SUCCESS_EXTENSION_LIMITER = False
SUCCESS_EXTENSION_LOGGER = False
SUCCESS_EXTENSION_LOGGIN = False
SUCCESS_EXTENSION_MARSHMALLOW = False
SUCCESS_EXTENSION_MIGRATE = False
SUCCESS_EXTENSION_REDIS = False
SUCCESS_EXTENSION_RESTFUL = False
SUCCESS_EXTENSION_SECURITY = False
SUCCESS_EXTENSION_SESSION = False
SUCCESS_EXTENSION_SQLALCHEMY = False
SUCCESS_EXTENSION_UPLOADS = False

SUCCESS_ENABLE_VIEW = True
SUCCESS_ENABLE_REST = False
SUCCESS_ENABLE_CLI = False
SUCCESS_ENABLE_GRAPHQL = False
SUCCESS_ENABLE_RPC = False
SUCCESS_ENABLE_SSE = False
SUCCESS_ENABLE_SOAP = False
SUCCESS_ENABLE_WEB_SOCKET = False

SUCCESS_OUTPUT_MODEL = False
SUCCESS_TABLENAME_MODEL = False
SUCCESS_CUSTOM_CONFIG_CLASS =
SUCCESS_SAVE_MODE = False
SUCCESS_HOST_MATCHING = False
SUCCESS_SUBDOMAIN_MATCHING = False


# ---------------------------------------
# Logger
# ---------------------------------------
LOGGER_CONSOLE = True
LOGGER_FILE = False
LOGGER_MAIL_ENABLED = False
LOGGER_LEVEL = 'ERROR'
LOGGER_ENCODING = 'utf-8'
LOGGER_FORMATER = 'json'
LOGGER_FORMAT = f"%(asctime)s - [%(levelname)s] - %(name)s - (%(filename)s).%(funcName)s(%(lineno)d) - %(message)s - %(threadName)s"
