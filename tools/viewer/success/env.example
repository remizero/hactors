# ----------------------------------------------------------
# Configuración global de Success — viewer de HACTORS
# ----------------------------------------------------------
# Copiar este archivo a success/.env antes de arrancar.
# ----------------------------------------------------------

APP_ENV = 'development'
FLASK_ENV = 'development'

# DEBUG activa el depurador de Werkzeug, que permite ejecutar código en el
# proceso. Es seguro mientras APP_HOST siga siendo 127.0.0.1; si se abre a otra
# interfaz, hay que apagar DEBUG.
DEBUG = True
APP_HOST = '127.0.0.1'
APP_PORT = 5000

BASE_URL =
SERVER_NAME =

SECRET_KEY = 'hactors_viewer_local'

SUCCESS_MAIN_APP = "hactors"
SUCCESS_SECONDARY_APPS = []
SUCCESS_APPS_PATH = "apps"
SUCCESS_APP_TYPE = "singleApp"
SUCCESS_APP_MODE = "standard"
SUCCESS_ALLOW_NO_MAIN_APP = False

SUCCESS_STRICT_SLASHES = False
SUCCESS_SAVE_MODE = False
SUCCESS_STAGING = False
SUCCESS_TESTING = False
SUCCESS_DEBUG_CONSOLE = False
SUCCESS_HUMOR_ENABLED = False
SUCCESS_MOOD_LANG = 'es'

SUCCESS_SHOW_SUMMARY = true
SUCCESS_SUMMARY_LEVEL = BASIC

# Raíz de HACTORS que el viewer proyecta. Vacío = detectarla subiendo desde el
# directorio de arranque, que debe ser tools/viewer/.
HACTORS_ROOT =


# ---------------------------------------
# Logger
# ---------------------------------------
# LOGGER_FILE escribe ./log/ relativo al directorio de arranque. Apagado: el
# viewer no debe dejar archivos en el repositorio.
LOGGER_CONSOLE = True
LOGGER_FILE = False
LOGGER_MAIL_ENABLED = False
LOGGER_LEVEL = 'ERROR'
LOGGER_ENCODING = 'utf-8'
LOGGER_FORMATER = 'json'
LOGGER_FORMAT = f"%(asctime)s - [%(levelname)s] - %(name)s - (%(filename)s).%(funcName)s(%(lineno)d) - %(message)s - %(threadName)s"
